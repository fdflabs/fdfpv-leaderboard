# Local default is a JSON file in data/board.json.
# Point this at Render Postgres, or a local Docker instance, to use SQL.
# DATABASE_URL=postgres://fdfpv:fdfpv@127.0.0.1:5432/fdfpvboard

# Where the Fly button sends people. The simulator repo, not this one.
# Everything downstream concatenates onto this, so it may carry a mount
# prefix as well as a host: behind fdfpv.example it is https://fdfpv.example/sim.
SIM_ORIGIN=http://127.0.0.1:8000

# Public address of THIS page, written into Fly links so the simulator can
# post times back. Leave unset to use the incoming request origin, which is
# right whenever this service is the whole site. It is not right behind a
# mount prefix: a header carries a host and a host has no path, so the
# request origin comes out as https://fdfpv.example, which is the landing page.
# The board's own page prefers its document.baseURI over this value for
# exactly that reason, so this is now belt and braces rather than the wiring.
# BOARD_PUBLIC_ORIGIN=https://fdfpv.example/board

# Set to 1 when something else terminates TLS in front of this process, so
# x-forwarded-proto and x-forwarded-host are believed when building Fly
# links. Required on Render and behind any https reverse proxy. Leave unset
# when the process is reachable directly: the headers are client supplied
# and are only trusted because this says a proxy sets them.
# BOARD_TRUST_PROXY=1

PORT=3100

# Optional. When set, listing and updating bug tickets needs
# Authorization: Bearer <token>. Testers can still submit without it.
# BUGS_TOKEN=

# Optional, and unset is the right default. The browser that published a
# track holds its edit key and can upload that track's card animation
# without this. This is the only way to upload one for a track published
# from a browser nobody still has, which is what the rooms already on the
# board were. See scripts/boardgif.js in the simulator's repository.
# BOARD_ADMIN_TOKEN=

# Who may sign in to the board's Admin panel. Unset uses the built-in list
# in src/admin.js, which is one address whose password is published with
# the source: fine for a checkout, wrong for a host that matters.
#
# One entry per line, or comma separated: email:scrypt:N:r:p:saltHex:hashHex.
# Mint one without the password touching a shell history:
#
#   node scripts/admin-hash.js someone@example.com
#
# email:plain:the password also works, for a local checkout only.
# SETTING THIS REPLACES the built-in list rather than adding to it, which
# is how a host drops the published default.
# BOARD_ADMINS=

# Optional, and unset is the right default. Mixed into the key that signs
# admin session tokens, so changing it signs everybody out at once without
# anybody's password having to change. Changing a password in BOARD_ADMINS
# already invalidates every session that password minted.
# BOARD_SESSION_SECRET=

# Who gets a sponsor link, and the only vocabulary a utm_source can take.
# One entry per line or comma separated, slug:Display Name. The slug is what
# travels in a link and must not change once a poster is printed; the name
# is what the statistics page prints and can.
#
#   BOARD_SPONSORS=rotorriot:Rotor Riot,fpvshop:The FPV Shop
#
# Unset is the right default and means no sponsors: every arrival on the
# statistics tab is Direct or Other. An arrival carrying a source this list
# does not name is folded into Other, which is what stops a stranger with
# curl growing a table on a public page.
#
# A signed in admin sees each sponsor's ready link in the Admin panel.
# BOARD_SPONSORS=
